# Variáveis de ambiente do Colheita Feliz. Copie para .env.local (dev) ou cadastre no provedor (produção).
# NUNCA coloque valores reais neste arquivo: ele vai para o Git.

# ---------- Banco ----------
# Sem DATABASE_URL o jogo usa PGlite (Postgres embutido em .data/pglite), bom para dev.
# Docker local: postgres://colheita:colheita@localhost:5433/colheita
DATABASE_URL=
DATABASE_POOL_MAX=10          # conexões por instância
DATABASE_SSL=                 # 1 = TLS (Postgres gerenciado costuma exigir)
DATABASE_SSL_INSECURE=        # 1 = aceita certificado sem cadeia confiável (só se o provedor pedir)

# ---------- App ----------
APP_ENV=                      # production | staging (aparece nos logs/Sentry; staging libera ALLOW_TEST_LOGIN no build de produção)
LOG_LEVEL=info                # debug | info | warn | error
COOKIE_SECURE=                # 0 só em produção local por http://
CLIENT_IP_HEADER=             # cabeçalho com o IP real, se o provedor tiver (fly-client-ip, cf-connecting-ip)
TRUST_PROXY_HOPS=1            # proxies nossos na frente do app (para ler o X-Forwarded-For)

# ---------- Build (entram no JavaScript do navegador; mudar = novo build) ----------
NEXT_PUBLIC_GAME_NAME=
NEXT_PUBLIC_COMMUNITY_URL=
GROWTH_SPEED=1                # >1 acelera o crescimento (só testes)

# ---------- Conta por e-mail (frente M) ----------
# Segredo dos códigos de entrada (HMAC). OBRIGATÓRIO em produção: gere com `openssl rand -base64 32`.
AUTH_SECRET=
# Endereço público usado no link mágico do e-mail. Ex.: https://colheitafeliz.com.br (sem isso, usa o host do pedido).
APP_URL=
# Remetente dos e-mails. Precisa ser de um domínio verificado no provedor (SPF/DKIM).
MAIL_FROM="Colheita Feliz <nao-responda@seudominio.com.br>"
# Provedor: smtp | resend | console | memory. Vazio = smtp; em dev, sem SMTP_HOST, vai para o Mailpit (localhost:1025).
#   docker run -d --name cf-mailpit -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 axllent/mailpit   (caixa: http://localhost:8025)
MAIL_PROVIDER=
# SMTP (Amazon SES, Brevo, Mailgun, Zoho…). Porta 465 = TLS direto; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=1
# Resend (MAIL_PROVIDER=resend): chave começa com re_.
RESEND_API_KEY=
# Login de teste só por apelido: ligado no dev (TEST_LOGIN=0 desliga). Em produção fica desligado;
# ALLOW_TEST_LOGIN=1 só num servidor de testes fechado e junto com APP_ENV=staging (sem isso fica bloqueado).
# TEST_LOGIN=0
# ALLOW_TEST_LOGIN=0

# ---------- Push (avisos no celular) ----------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# ---------- Erros ----------
SENTRY_DSN=                   # https://<chave>@oXXXX.ingest.sentry.io/<projeto> (vazio = só log)
APP_VERSION=                  # o Dockerfile preenche com o commit

# Vitrine da página inicial (ranking público só com iniciais): contas de teste (login só por apelido, sem e-mail) ficam
# de fora. Só em desenvolvimento, VITRINE_TEST_ACCOUNTS=1 as inclui para QA (ignorado em produção).
VITRINE_TEST_ACCOUNTS=
